# Скопіюйте цей файл у .env і відредагуйте за потреби:
#   cp .env.example .env
#
# Перед запуском експериментів увімкніть port-forward до сервісів у кластері:
#   kubectl port-forward -n application svc/mlflow 5000:5000 &
#   kubectl port-forward -n application svc/minio 9000:9000 &
#   kubectl port-forward -n monitoring  svc/pushgateway-prometheus-pushgateway 9091:9091 &

# MLflow Tracking Server (через port-forward)
MLFLOW_TRACKING_URI=http://localhost:5000

# MinIO (S3-сумісне сховище для artifacts) — креденшали з argocd/applications/minio.yaml
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Prometheus PushGateway
PUSHGATEWAY_URL=http://localhost:9091
